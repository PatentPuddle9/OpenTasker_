<?xml version="1.0" encoding="utf-8"?>
<!--
    Colours for the surfaces Compose never draws: the home screen widget, the splash and
    pre-composition window fill, and the notification accent. Each one is a named colour from the
    light scheme in ui/theme/Theme.kt, and the dark variants in values-night come from the dark
    scheme. ThemeResourceColorParityTest pins every value to its Theme.kt name, because these were
    left on the retired sage palette when the app moved to Quiet Workshop.
-->
<resources>
    <!-- LightSurface -->
    <color name="widget_background">#FFFFFF</color>
    <!-- LightOutline -->
    <color name="widget_border">#85768F</color>
    <!-- LightPurple -->
    <color name="widget_primary">#7652A8</color>
    <!-- LightText -->
    <color name="widget_text_primary">#211A2A</color>
    <!-- LightSubtext -->
    <color name="widget_text_secondary">#655A70</color>
    <!-- LightBase: the splash and pre-composition window fill. -->
    <color name="window_background">#F7F3FA</color>
    <!-- BrandPurple: the notification accent, in both themes. -->
    <color name="notification_accent">#B69CFF</color>
</resources>
